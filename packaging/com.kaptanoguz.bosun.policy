<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
  "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!--
  Bosun yardımcısı için polkit kuralı. Yalnızca /usr/lib/bosun/bosun-helper bu kuralla
  çalıştırılabilir ve her seferinde yönetici şifresi istenir (5 dakika önbelleğe alınır).
  Yardımcı yalnızca sabit bir eylem listesini kabul eder; serbest komut çalıştırmaz.
-->
<policyconfig>
  <vendor>Bosun</vendor>
  <vendor_url>https://github.com/kaptanoguz/Bosun</vendor_url>
  <icon_name>bosun</icon_name>
  <action id="com.kaptanoguz.bosun.helper">
    <description>Run Bosun system maintenance</description>
    <description xml:lang="tr">Bosun sistem bakımını çalıştır</description>
    <message>Bosun needs administrator rights to clean system files or change a system setting.</message>
    <message xml:lang="tr">Bosun, sistem dosyalarını temizlemek ya da bir sistem ayarını değiştirmek için yönetici yetkisine ihtiyaç duyuyor.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/bosun/bosun-helper</annotate>
  </action>
</policyconfig>
