# .deb paketiyle kurulan sürüm: bosund /usr/bin altında.
[Unit]
Description=Bosun system maintenance service
Documentation=https://github.com/kaptanoguz/Bosun
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/bosund
Restart=on-failure
RestartSec=5
EnvironmentFile=-%h/.config/bosun/env
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
# Not: ProtectSystem/PrivateTmp gibi seçenekler kullanıcı servislerinde ayrı bir kullanıcı
# ad alanı açar; o zaman root'a ait dosyalar "nobody" görünür ve yardımcı denetimi bozulur.

[Install]
WantedBy=default.target
